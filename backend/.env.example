# Application environment: development, staging, or production.
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE
OPENROUTER_API_KEY=replace-with-your-key
SECRET_KEY=generate-a-long-random-secret
SESSION_SECRET_KEY=generate-a-second-long-random-secret

# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_CREDENTIALS=true
COOKIE_SECURE=false

# Set false on multi-instance deployments and run cleanup as a separate cron job.
ENABLE_IN_APP_SCHEDULER=true

FREE_MODEL_NAME=meta-llama/llama-3.1-8b-instruct
PAID_MODEL_NAME=meta-llama/llama-3.1-8b-instruct
DETECTOR_MODEL_NAME=openai/gpt-4o-mini
TEMPERATURE=0.7

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@humary.com
SMTP_FROM_NAME=Humary

LLM_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=сюда_ключ_авторизации_из_кабинета
GIGACHAT_SCOPE=GIGACHAT_API_PERS
MODEL_NAME=GigaChat-2
