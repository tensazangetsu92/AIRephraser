# Copy this file to backend/.env for local development. Never commit backend/.env.
# Production values belong in the hosting platform's encrypted environment settings.
APP_ENV=development
# DEBUG for local troubleshooting; INFO is the production default.
# WARNING and ERROR progressively reduce non-critical log output.
LOG_LEVEL=INFO
DEV_LOG_VERIFICATION_CODE=false

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# Generate independent values, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
SESSION_SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters-long

# Browser and server settings. In production set APP_ENV=production, use only
# https:// URLs here and set COOKIE_SECURE=true (the application enforces it).
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_CREDENTIALS=true
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=8000
RELOAD=true
ENABLE_IN_APP_SCHEDULER=true
API_RATE_LIMIT_ENABLED=true

# Authentication session lifetime
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_IDLE_DAYS=14
AUTH_REFRESH_TOKEN_ABSOLUTE_DAYS=30

# GigaChat (default provider)
LLM_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=replace-with-gigachat-authorization-key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_API_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_VERIFY_SSL=true
MODEL_NAME=GigaChat-2
DETECTOR_MODEL_NAME=GigaChat-2
TEMPERATURE=0.7
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENT_REQUESTS=3
USER_PROCESSING_LOCK_TTL_SECONDS=7200

# Alternative Cloud.ru provider. Fill only when LLM_PROVIDER=cloud_gpt.
GPT_AUTH_KEY=
GPT_API_BASE_URL=https://foundation-models.api.cloud.ru/v1

# OAuth callback URLs must exactly match values registered with the providers.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/auth/yandex/callback
VK_ID_APP_ID=
VK_ID_REDIRECT_URI=http://localhost:8000/auth/vk/callback

# SMTP
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
# true for implicit TLS/SSL providers such as Mail.ru on port 465;
# false for STARTTLS providers such as Gmail or Yandex on port 587.
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@humary.com
SMTP_FROM_NAME=Humary
