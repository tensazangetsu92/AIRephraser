{
    email {$ACME_EMAIL}
}

# Production is the only public HTTPS entry point. It proxies both host names
# to separate application containers over the private humary-proxy network.
{$SITE_DOMAIN} {
    encode zstd gzip
    reverse_proxy humary-production-app:8000

    header {
        -Server
    }
}

{$WWW_SITE_DOMAIN} {
    # Keep a single canonical public address while preserving the requested
    # path and query string. Caddy also obtains a certificate for this name.
    redir https://{$SITE_DOMAIN}{uri} permanent
}

{$STAGING_SITE_DOMAIN} {
    encode zstd gzip
    reverse_proxy humary-staging-app:8000

    header {
        -Server
    }
}
