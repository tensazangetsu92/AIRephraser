# Copy to deploy/production.env on the server. Do not commit the copied file.
# DATABASE_URL must use the Docker Compose service name "db", not localhost.
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg2://humary:replace-with-a-long-postgres-password@db:5432/humary
POSTGRES_DB=humary
POSTGRES_USER=humary
POSTGRES_PASSWORD=replace-with-a-long-postgres-password

# Generate two independent values, each at least 32 characters long:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
SESSION_SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters-long

# Must be the same HTTPS address as SITE_DOMAIN in deploy/production-caddy.env.
FRONTEND_URL=https://humary.ru
CORS_ORIGINS=https://humary.ru
CORS_CREDENTIALS=true
COOKIE_SECURE=true
HOST=0.0.0.0
PORT=8000
RELOAD=false
ENABLE_IN_APP_SCHEDULER=false
API_RATE_LIMIT_ENABLED=true
# Verification codes must never be written to production or staging logs.
DEV_LOG_VERIFICATION_CODE=false

AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_IDLE_DAYS=14
AUTH_REFRESH_TOKEN_ABSOLUTE_DAYS=30

LLM_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=replace-with-gigachat-authorization-key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_API_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_VERIFY_SSL=true
MODEL_NAME=GigaChat-2
DETECTOR_MODEL_NAME=GigaChat-2
TEMPERATURE=0.7
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENT_REQUESTS=3
USER_PROCESSING_LOCK_TTL_SECONDS=7200

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://humary.ru/auth/yandex/callback
VK_ID_APP_ID=
VK_ID_REDIRECT_URI=https://humary.ru/auth/vk/callback

SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS/SSL providers such as Mail.ru on port 465;
# false for STARTTLS providers such as Gmail or Yandex on port 587.
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=humary.service@mail.ru
SMTP_FROM_NAME=Humary

# Robokassa one-time payments. Keep false until the shop is approved, the
# public legal/payment information is complete, and a successful test payment
# has been verified. Never commit a copied production.env file.
PAYMENTS_ENABLED=false
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_IS_TEST=false
ROBOKASSA_HASH_ALGORITHM=md5
