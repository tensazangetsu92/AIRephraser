# This file lives on the VPS as /etc/humary/backup.env with permissions 600.
# It is read by the systemd backup service, not by FastAPI.
# Standard production deployment. For staging, use the values shown below.
COMPOSE_FILE=/opt/humary/docker-compose.yml
COMPOSE_ENV_FILE=
COMPOSE_PROJECT_NAME=
POSTGRES_SERVICE=db
POSTGRES_USER=humary
POSTGRES_DB=humary
BACKUP_DIR=/var/backups/humary
BACKUP_RETENTION_DAYS=14

# Optional: an rclone crypt remote in a different storage location.
# Example: BACKUP_RCLONE_REMOTE=humary-encrypted:postgres
BACKUP_RCLONE_REMOTE=

# Staging example:
# COMPOSE_ENV_FILE=/opt/humary/deploy/compose.staging.env
# COMPOSE_PROJECT_NAME=humary-staging
